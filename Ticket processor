"""
FastAPI application and routing.
"""
from fastapi import FastAPI, HTTPException
from contextlib import asynccontextmanager
from .models import TicketCreate, TicketUpdate
from . import store

# Data path (assuming we run Uvicorn from the root folder)
DATA_PATH = "data/tickets_report.json"

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Lifespan event to load data on startup (FR18)."""
    store.load_data(DATA_PATH)
    yield

app = FastAPI(title="NimbusTech Ticket Triage API", lifespan=lifespan)

@app.get("/")
def read_root():
    """FR11: Basic root endpoint."""
    return {"status": "ok", "service": "ticket-triage-api"}

@app.get("/tickets")
def get_tickets():
    """FR12: Return the full list of processed tickets."""
    return store.get_all_tickets()

@app.get("/tickets/breached")
def get_breached_tickets():
    """FR13: Return only tickets that breached their SLA."""
    tickets = store.get_all_tickets()
    return [t for t in tickets if t.get("sla_breached") is True]

@app.get("/tickets/{ticket_id}")
def get_ticket_by_id(ticket_id: str):
    """FR14: Return one ticket by id; 404 if missing."""
    ticket = store.get_ticket(ticket_id)
    if not ticket:
        raise HTTPException(status_code=404, detail="Ticket not found")
    return ticket

@app.post("/tickets")
def create_ticket(ticket_in: TicketCreate):
    """FR15: Add a new ticket record."""
    if store.get_ticket(ticket_in.ticket_id):
        raise HTTPException(status_code=400, detail="Ticket with this ID already exists")
    
    # Calculate basic priority score for the new entry
    priority_map = {"low": 1, "medium": 2, "high": 3, "critical": 4}
    p_score = priority_map.get(ticket_in.priority_raw.lower(), 1)

    new_ticket = ticket_in.model_dump()
    new_ticket["priority_score"] = p_score
    new_ticket["sla_breached"] = False  # Default to false for new manual entries MVP

    store.add_ticket(new_ticket)
    return new_ticket

@app.put("/tickets/{ticket_id}")
def update_ticket(ticket_id: str, ticket_in: TicketUpdate):
    """FR16: Update an existing ticket's status and/or priority_raw."""
    existing_ticket = store.get_ticket(ticket_id)
    if not existing_ticket:
        raise HTTPException(status_code=404, detail="Ticket not found")

    if ticket_in.status is not None:
        existing_ticket["status"] = ticket_in.status

    if ticket_in.priority_raw is not None:
        existing_ticket["priority_raw"] = ticket_in.priority_raw
        priority_map = {"low": 1, "medium": 2, "high": 3, "critical": 4}
        existing_ticket["priority_score"] = priority_map.get(
            ticket_in.priority_raw.lower(), 
            existing_ticket["priority_score"]
        )

    return existing_ticket

@app.delete("/tickets/{ticket_id}")
def remove_ticket(ticket_id: str):
    """FR17: Remove a ticket record."""
    success = store.delete_ticket(ticket_id)
    if not success:
        raise HTTPException(status_code=404, detail="Ticket not found")
    return {"status": "deleted", "ticket_id": ticket_id}



