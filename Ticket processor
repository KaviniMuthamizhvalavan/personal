"""
FastAPI application and routing using SQLAlchemy.
"""
import json
import os
import logging
from fastapi import FastAPI, HTTPException, Depends
from sqlalchemy.orm import Session
from contextlib import asynccontextmanager

from . import models, schemas, crud
from .database import SessionLocal, engine

logger = logging.getLogger(__name__)

# Create the database tables
models.Base.metadata.create_all(bind=engine)

DATA_PATH = "data/tickets_report.json"

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Lifespan event to seed the SQLite DB from JSON report if it's empty."""
    db = SessionLocal()
    try:
        if db.query(models.Ticket).count() == 0 and os.path.exists(DATA_PATH):
            with open(DATA_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
                tickets_list = data.get("tickets", [])
                for t in tickets_list:
                    db_ticket = models.Ticket(**t)
                    db.add(db_ticket)
                db.commit()
                logger.info(f"Successfully seeded DB with {len(tickets_list)} tickets from JSON.")
    except Exception as e:
        logger.error(f"Error seeding database: {e}")
    finally:
        db.close()
    yield

app = FastAPI(title="NimbusTech Ticket Triage API (SQLAlchemy)", lifespan=lifespan)

# Dependency to get the DB session per request
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

@app.get("/")
def read_root():
    return {"status": "ok", "service": "ticket-triage-api", "database": "sqlite"}

@app.get("/tickets", response_model=list[schemas.TicketResponse])
def get_tickets(db: Session = Depends(get_db)):
    return crud.get_all_tickets(db)

@app.get("/tickets/breached", response_model=list[schemas.TicketResponse])
def get_breached_tickets(db: Session = Depends(get_db)):
    return crud.get_breached_tickets(db)

@app.get("/tickets/{ticket_id}", response_model=schemas.TicketResponse)
def get_ticket_by_id(ticket_id: str, db: Session = Depends(get_db)):
    ticket = crud.get_ticket(db, ticket_id)
    if not ticket:
        raise HTTPException(status_code=404, detail="Ticket not found")
    return ticket

@app.post("/tickets", response_model=schemas.TicketResponse)
def create_ticket(ticket_in: schemas.TicketCreate, db: Session = Depends(get_db)):
    if crud.get_ticket(db, ticket_in.ticket_id):
        raise HTTPException(status_code=400, detail="Ticket with this ID already exists")
    
    priority_map = {"low": 1, "medium": 2, "high": 3, "critical": 4}
    p_score = priority_map.get(ticket_in.priority_raw.lower(), 1)
    
    return crud.create_ticket(db, ticket_in, priority_score=p_score)

@app.put("/tickets/{ticket_id}", response_model=schemas.TicketResponse)
def update_ticket(ticket_id: str, ticket_in: schemas.TicketUpdate, db: Session = Depends(get_db)):
    updated_ticket = crud.update_ticket(db, ticket_id, ticket_in)
    if not updated_ticket:
        raise HTTPException(status_code=404, detail="Ticket not found")
    return updated_ticket

@app.delete("/tickets/{ticket_id}")
def remove_ticket(ticket_id: str, db: Session = Depends(get_db)):
    success = crud.delete_ticket(db, ticket_id)
    if not success:
        raise HTTPException(status_code=404, detail="Ticket not found")
    return {"status": "deleted", "ticket_id": ticket_id}
