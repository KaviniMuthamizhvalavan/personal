import os
from datetime import datetime
from dotenv import load_dotenv
from sqlalchemy import create_engine, Column, Integer, String, DateTime
from sqlalchemy.orm import declarative_base, sessionmaker

load_dotenv()

# Get connection string from environment variables
SQL_CONNECTION_STRING = os.getenv("AZURE_SQL_CONNECTION_STRING")

engine = create_engine(SQL_CONNECTION_STRING, echo=False)
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
Base = declarative_base()

# Database Schema
class Document(Base):
    __tablename__ = "Documents"

    document_id = Column(Integer, primary_key=True, index=True)
    file_name = Column(String(255), index=True)
    blob_url = Column(String(1000))
    uploaded_by = Column(String(255))
    upload_date = Column(DateTime, default=datetime.utcnow)
    file_type = Column(String(50))

# Create tables in the database if they don't exist
Base.metadata.create_all(bind=engine)

def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()
import os
import uuid
from datetime import datetime, timedelta, timezone
from fastapi import FastAPI, UploadFile, File, Form, Depends, HTTPException
from fastapi.responses import StreamingResponse
from sqlalchemy.orm import Session
from dotenv import load_dotenv
from azure.storage.blob import BlobServiceClient, generate_blob_sas, BlobSasPermissions

from database import get_db, Document

load_dotenv()

app = FastAPI(title="Smart Document Management System API")

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING = os.getenv("AZURE_STORAGE_CONNECTION_STRING")
AZURE_CONTAINER_NAME = os.getenv("AZURE_CONTAINER_NAME")

blob_service_client = BlobServiceClient.from_connection_string(AZURE_STORAGE_CONNECTION_STRING)
container_client = blob_service_client.get_container_client(AZURE_CONTAINER_NAME)

@app.post("/upload/")
async def upload_document(
    file: UploadFile = File(...), 
    uploaded_by: str = Form("anonymous"), 
    db: Session = Depends(get_db)
):
    """Uploads a document to Azure Blob Storage and stores metadata in Azure SQL."""
    # Generate unique filename to prevent overwriting
    file_extension = file.filename.split(".")[-1]
    unique_filename = f"{uuid.uuid4()}.{file_extension}"
    
    # 1. Store file in Azure Blob Storage
    blob_client = container_client.get_blob_client(unique_filename)
    blob_client.upload_blob(file.file)
    
    # 2. Store metadata in Azure SQL Database
    new_doc = Document(
        file_name=file.filename,
        blob_url=blob_client.url,
        uploaded_by=uploaded_by,
        upload_date=datetime.utcnow(),
        file_type=file.content_type
    )
    db.add(new_doc)
    db.commit()
    db.refresh(new_doc)
    
    return {"message": "Document uploaded successfully", "document_id": new_doc.document_id}

@app.get("/documents/")
def view_all_documents(db: Session = Depends(get_db)):
    """Returns a list of all uploaded documents."""
    docs = db.query(Document).all()
    return docs

@app.get("/documents/{document_id}")
def view_document_by_id(document_id: int, db: Session = Depends(get_db)):
    """Retrieves the metadata of a specific document."""
    doc = db.query(Document).filter(Document.document_id == document_id).first()
    if not doc:
        raise HTTPException(status_code=404, detail="Document not found")
    return doc

@app.get("/download/{document_id}")
def download_document(document_id: int, db: Session = Depends(get_db)):
    """Allows users to download the document stored in Azure Blob Storage."""
    doc = db.query(Document).filter(Document.document_id == document_id).first()
    if not doc:
        raise HTTPException(status_code=404, detail="Document not found")
    
    blob_name = doc.blob_url.split("/")[-1]
    blob_client = container_client.get_blob_client(blob_name)
    
    stream = blob_client.download_blob()
    return StreamingResponse(
        stream.chunks(), 
        media_type=doc.file_type, 
        headers={"Content-Disposition": f"attachment; filename={doc.file_name}"}
    )

@app.post("/documents/{document_id}/share")
def generate_secure_share_link(
    document_id: int, 
    expiry_minutes: int = 60, 
    db: Session = Depends(get_db)
):
    """Generates a secure, time-limited sharing link (SAS URL) that automatically expires."""
    doc = db.query(Document).filter(Document.document_id == document_id).first()
    if not doc:
        raise HTTPException(status_code=404, detail="Document not found")
    
    blob_name = doc.blob_url.split("/")[-1]
    
    # Extract account name and key from connection string
    conn_str_dict = dict(item.split('=', 1) for item in AZURE_STORAGE_CONNECTION_STRING.split(';'))
    account_name = conn_str_dict['AccountName']
    account_key = conn_str_dict['AccountKey']
    
    # Generate SAS token
    sas_token = generate_blob_sas(
        account_name=account_name,
        container_name=AZURE_CONTAINER_NAME,
        blob_name=blob_name,
        account_key=account_key,
        permission=BlobSasPermissions(read=True),
        expiry=datetime.now(timezone.utc) + timedelta(minutes=expiry_minutes)
    )
    
    sas_url = f"https://{account_name}.blob.core.windows.net/{AZURE_CONTAINER_NAME}/{blob_name}?{sas_token}"
    
    return {
        "document_id": document_id,
        "secure_url": sas_url,
        "expires_in_minutes": expiry_minutes
    }

@app.delete("/documents/{document_id}")
def delete_document(document_id: int, db: Session = Depends(get_db)):
    """Removes the file from Azure Blob Storage and metadata from Azure SQL Database."""
    doc = db.query(Document).filter(Document.document_id == document_id).first()
    if not doc:
        raise HTTPException(status_code=404, detail="Document not found")
    
    # 1. Remove file from Azure Blob Storage
    try:
        blob_name = doc.blob_url.split("/")[-1]
        blob_client = container_client.get_blob_client(blob_name)
        blob_client.delete_blob()
    except Exception as e:
        print(f"Blob deletion failed or already deleted: {e}")
        
    # 2. Remove metadata from Azure SQL Database
    db.delete(doc)
    db.commit()
    
    return {"message": "Document deleted successfully"}
