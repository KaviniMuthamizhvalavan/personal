        <input type="text" id="title" placeholder="Title (Required)" required>
        <input type="text" id="author" placeholder="Author (Required)" required>
        <input type="text" id="genre" placeholder="Genre (Optional)">
        <select id="status">
            <option value="available">Available</option>
            <option value="borrowed">Borrowed</option>
        </select>
        <button id="save-btn" onclick="saveBook()">Add Book</button>
        <button onclick="resetForm()">Clear Form</button>
    </div>

    <!-- Form for searching a specific book by ID -->
    <div class="form-container search-container">
        <h3>Search Book by ID</h3>
        <input type="number" id="search-id" placeholder="Enter Book ID">
        <button onclick="searchBookById()">Search</button>
        <button onclick="fetchBooks()">Reset List (Show All)</button>
    </div>

