        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="book-list">
            <!-- Books will be injected here via JavaScript -->
        </tbody>
    </table>

    <script>
        const API_URL = '/books';

        // 1. Fetch and display all books
        async function fetchBooks() {
            const response = await fetch(API_URL);
            const books = await response.json();
            renderTable(books);
        }

        // 2. Fetch and display a single book by ID
        async function searchBookById() {
            const id = document.getElementById('search-id').value;
            if (!id) {
                alert('Please enter a valid Book ID.');
                return;
            }

            const response = await fetch(`${API_URL}/${id}`);
            
            if (response.ok) {
                const book = await response.json();
                renderTable([book]); // Render as an array of one
            } else if (response.status === 404) {
                const tbody = document.getElementById('book-list');
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Book not found</td></tr>';
            } else {
                alert('An error occurred.');
            }
        }

        // Helper function to render the HTML table rows
        function renderTable(books) {
            const tbody = document.getElementById('book-list');
            tbody.innerHTML = '';
            
            books.forEach(book => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${book.id}</td>
                    <td>${book.title}</td>
                    <td>${book.author}</td>
                    <td>${book.genre || '-'}</td>
                    <td>${book.status}</td>
